#!/usr/bin/env python3
"""Sync dotfiles declarations around the standard user-scope APM commands."""

import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

FILES = ("apm.yml", "apm.lock.yaml")
SOURCE = Path(__file__).resolve().parents[1] / "config/apm"
RUNTIME = Path.home() / ".apm"


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else None


def sync_files(source, destination):
    for name in FILES:
        src, dst = source / name, destination / name
        if src.exists():
            temporary = dst.with_name(dst.name + ".dotfiles-tmp")
            shutil.copyfile(src, temporary)
            os.replace(temporary, dst)
        elif dst.exists():
            dst.unlink()


def save_state(path):
    state = {name: digest(RUNTIME / name) for name in FILES}
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n")
    os.replace(temporary, path)


def main():
    args = sys.argv[1:]
    if not args or args == ["--help"]:
        print("Usage: scripts/apm-global {install|outdated|update|uninstall} [APM options]")
        print("       scripts/apm-global deps list")
        print("       scripts/apm-global import  # explicitly keep direct APM metadata edits")
        return 0
    importing = args == ["import"]
    valid = args[0] in {"install", "outdated", "update", "uninstall"} or args == ["deps", "list"]
    if not importing and (not valid or any(arg.split("=")[0] == "--root" for arg in args)):
        raise ValueError("Use a supported user-scope command; project/root overrides are not supported.")
    if RUNTIME.is_symlink():
        raise ValueError("APM 0.30.0 requires ~/.apm to be a real directory.")
    RUNTIME.mkdir(mode=0o700, exist_ok=True)
    with (RUNTIME / ".dotfiles-sync.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state_path = RUNTIME / ".dotfiles-sync.json"
        if importing:
            if not (RUNTIME / "apm.yml").is_file():
                raise ValueError("No user manifest to import.")
            sync_files(RUNTIME, SOURCE)
            save_state(state_path)
            print("Imported user APM metadata. Review the config/apm Git diff.")
            return 0
        baseline = json.loads(state_path.read_text()) if state_path.exists() else {}
        # Never silently overwrite updates made with a direct `apm ... --global`.
        for name in FILES:
            actual, desired = digest(RUNTIME / name), digest(SOURCE / name)
            if actual != baseline.get(name) and actual != desired:
                raise ValueError(f"{RUNTIME / name} changed outside this wrapper. Review it, then use 'scripts/apm-global import' to keep it.")
        if not (SOURCE / "apm.yml").is_file():
            raise ValueError("The dotfiles manifest is missing.")
        sync_files(SOURCE, RUNTIME)
        save_state(state_path)
        result = subprocess.run(["apm", *args, "--global"], cwd=SOURCE)
        if result.returncode:
            print("APM failed; dotfiles metadata was not updated. Inspect ~/.apm before retrying.", file=sys.stderr)
            return result.returncode
        sync_files(RUNTIME, SOURCE)
        save_state(state_path)
        return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"Error: {error}", file=sys.stderr)
        sys.exit(1)
